# Server Configuration
NODE_ENV=development
PORT=8010
FRONTEND_URL=http://localhost:8010
TZ=UTC

# MongoDB Configuration
MONGODB_URI=

# JWT Secret (generate a strong random string, 32+ chars)
JWT_SECRET=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (Gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Scraper Service Configuration
SCRAPER_SERVICE_URL=http://localhost:5000
SCRAPER_PORT=5000
SCRAPER_SERVICE_ENABLED=true

# Platform-specific Keyword/Prompt Limits (configured in backend/config/database.js)
# - Keyword-based platforms (Reddit, Quora): 5 keywords each
# - Prompt-based platforms (Perplexity, ChatGPT, Google AI): 25 prompts each

# Scraper Interval Configuration
# How often keyword-based scrapers run (Reddit, Quora) - in hours
KEYWORD_SCRAPER_INTERVAL_HOURS=3

# How often prompt-based scrapers run (Perplexity, ChatGPT, Google AI) - in hours
PROMPT_SCRAPER_INTERVAL_HOURS=24

# Queue Concurrency Configuration
# Default concurrency for all platforms (how many jobs can run in parallel per platform)
SCRAPER_CONCURRENCY=2

# Platform-specific concurrency (optional, overrides SCRAPER_CONCURRENCY)
# Set higher values if you have good server resources
REDDIT_CONCURRENCY=2
QUORA_CONCURRENCY=2
PERPLEXITY_CONCURRENCY=1
CHATGPT_CONCURRENCY=1
# TWITTER_CONCURRENCY=2

# Data Retention Configuration
# ScraperHistory records older than this will be automatically deleted
HISTORY_RETENTION_DAYS=30

# Chrome Profile Overrides (for Playwright scrapers)
# Each prompt-based scraper uses a different Chrome profile for login sessions
LINKEDIN_PROFILE=chrome_profile_linkedin
QUORA_PROFILE=chrome_profile_quora
CHATGPT_PROFILE=chrome_profile_chatgpt
PERPLEXITY_PROFILE=chrome_profile_perplexity
GOOGLEAI_PROFILE=chrome_profile_googleai

# YouTube Data API v3 Key (required for YouTube scraper)
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

